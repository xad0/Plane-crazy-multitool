:root { color-scheme: dark; --bg:#11111b; --surface:#181825; --panel:#1e1e2e; --text:#cdd6f4; --muted:#7f849c; --border:#45475a; --accent:#a6e3a1; --danger:#f38ba8; --warning:#f9e2af; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:var(--bg); color:var(--text); }
:root[data-theme="catppuccin-latte"] { color-scheme:light; --bg:#eff1f5; --surface:#e6e9ef; --panel:#ccd0da; --text:#4c4f69; --muted:#6c6f85; --border:#9ca0b0; }
:root[data-theme="catppuccin-frappe"] { --bg:#303446; --surface:#292c3c; --panel:#414559; --text:#c6d0f5; --muted:#a5adce; --border:#737994; }
:root[data-theme="catppuccin-macchiato"] { --bg:#24273a; --surface:#1e2030; --panel:#363a4f; --text:#cad3f5; --muted:#a5adcb; --border:#6e738d; }
:root[data-theme="nord"] { --bg:#2e3440; --surface:#3b4252; --panel:#434c5e; --text:#eceff4; --muted:#88c0d0; --border:#4c566a; }
:root[data-theme="gruvbox"] { --bg:#1d2021; --surface:#282828; --panel:#3c3836; --text:#ebdbb2; --muted:#a89984; --border:#504945; }
:root[data-theme="solid"] { --bg:#080808; --surface:#101010; --panel:#151515; --text:#eee; --muted:#777; --border:#303030; }
:root[data-accent="blue"]{--accent:#89b4fa}:root[data-accent="purple"]{--accent:#cba6f7}:root[data-accent="red"]{--accent:#f38ba8}:root[data-accent="orange"]{--accent:#fab387}:root[data-accent="cyan"]{--accent:#89dceb}:root[data-accent="pink"]{--accent:#f5c2e7}
* { box-sizing:border-box } body { margin:0; min-width:320px; min-height:100dvh; background:var(--bg); } button,input,select { font:inherit } button { cursor:pointer } button:focus-visible,input:focus-visible,select:focus-visible { outline:3px solid color-mix(in srgb,var(--accent),transparent 40%); outline-offset:2px }
.app-shell { width:min(1440px,100%); margin:auto; padding:0 max(1rem, env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)); }.app-header { min-height:4.5rem; display:flex; gap:1rem; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); position:sticky; top:0; background:color-mix(in srgb,var(--bg) 94%,transparent); backdrop-filter:blur(16px); z-index:5; }.brand { flex:none; color:var(--text); font-size:1.1rem; font-weight:800; letter-spacing:-.03em; text-decoration:none }.brand span,h1,h2 { color:var(--accent) } nav { display:flex; gap:.25rem; overflow-x:auto; scrollbar-width:none; padding:.55rem 0 } nav button { min-height:2.75rem; border:0; border-radius:.65rem; background:transparent; color:var(--muted); padding:.5rem .75rem; white-space:nowrap } nav button:hover,nav button.active { background:var(--panel); color:var(--text) } nav button.active { box-shadow:inset 0 -2px var(--accent) }
main { padding-top:clamp(1.5rem,4vw,3rem) }.page-header { max-width:44rem; margin-bottom:1.5rem }.page-header h1 { font-size:clamp(1.8rem,5vw,3rem); margin:0 0 .35rem; letter-spacing:-.045em }.page-header p,.muted { color:var(--muted); margin:0; line-height:1.55 }.tool-grid { display:grid; gap:1rem; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start }.card { background:var(--panel); border:1px solid var(--border); border-radius:1rem; padding:clamp(1rem,3vw,1.5rem); min-width:0 }.card h2 { color:var(--text); font-size:.78rem; letter-spacing:.11em; text-transform:uppercase; margin:0 0 1.15rem }.wide,.dyno-chart { grid-column:1 / -1 }.field { display:block; margin-bottom:1rem }.field>span { display:block; margin-bottom:.45rem; color:var(--muted); font-size:.85rem; font-weight:650 }.field input,.field select,.dyno-row input { width:100%; min-height:3rem; border:1px solid var(--border); border-radius:.65rem; background:var(--surface); color:var(--text); padding:.65rem .8rem }.field small { color:var(--muted); display:block; margin-top:.4rem }.switch { display:flex; gap:.7rem; align-items:center; min-height:2.8rem; margin:1rem 0; font-weight:600 }.switch input,.checks input { accent-color:var(--accent); width:1.1rem; height:1.1rem }.results-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:.7rem }.result { border-radius:.7rem; background:var(--surface); padding:.8rem }.result span { display:block; color:var(--muted); font-size:.75rem; margin-bottom:.35rem }.result strong { display:block; overflow-wrap:anywhere; font-size:1rem }.notice { border-radius:.7rem; padding:.8rem 1rem; font-weight:750; font-size:.9rem }.notice.error { background:color-mix(in srgb,var(--danger),transparent 83%); color:var(--danger) }.notice.warn { background:color-mix(in srgb,var(--warning),transparent 83%); color:var(--warning) }.table-wrap { overflow:auto; margin:-.2rem }.table-wrap table { border-collapse:collapse; width:100%; min-width:42rem; font-variant-numeric:tabular-nums }.table-wrap th { color:var(--muted); font-size:.75rem; text-transform:uppercase; letter-spacing:.06em; text-align:left }.table-wrap th,.table-wrap td { padding:.75rem; border-bottom:1px solid var(--border); white-space:nowrap }.table-wrap tbody tr:last-child td { border:0 }.phase-list { list-style:none; padding:0; margin:1rem 0 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(10rem,1fr)); gap:.5rem }.phase-list li { background:var(--surface); padding:.7rem; border-radius:.6rem; display:flex; justify-content:space-between; gap:.5rem }.phase-list span { color:var(--muted) }
.dyno-data { grid-column:span 1 }.dyno-table { display:grid; gap:.45rem; max-height:31rem; overflow:auto; padding-right:.2rem }.dyno-head,.dyno-row { display:grid; grid-template-columns:2rem 1fr 1fr; gap:.5rem; align-items:center }.dyno-head { color:var(--muted); font-size:.75rem; font-weight:700; text-transform:uppercase }.dyno-row>span { color:var(--muted); text-align:center }.dyno-row input { min-width:0; min-height:2.8rem }.secondary { min-height:2.75rem; padding:.5rem .9rem; border:1px solid var(--border); border-radius:.65rem; margin-top:1rem; color:var(--text); background:var(--surface); font-weight:700 }.secondary:hover { border-color:var(--accent); color:var(--accent) }.secondary:disabled { opacity:.45; cursor:not-allowed }.chart-wrap { height:clamp(280px,48vw,530px); position:relative }.chart { width:100%; height:100%; touch-action:none; display:block; border-radius:.5rem; background:var(--surface) }.chart-tip { position:absolute; top:1rem; right:1rem; padding:.45rem .65rem; border-radius:.45rem; color:var(--text); background:color-mix(in srgb,var(--bg) 90%,transparent); font-size:.8rem; pointer-events:none }.export { position:absolute; bottom:.75rem; right:.75rem; margin:0 }.peaks { margin-top:1rem; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.7rem }.checks { display:grid; grid-template-columns:repeat(auto-fit,minmax(11rem,1fr)); gap:.75rem }.checks label { display:flex; align-items:center; gap:.4rem; min-height:2rem }
.settings-tabs { grid-column:1 / -1; display:flex; gap:.4rem; overflow:auto; padding-bottom:.15rem }.settings-tabs button { min-height:2.7rem; border:1px solid var(--border); border-radius:.65rem; background:var(--surface); color:var(--muted); padding:.5rem .85rem; white-space:nowrap; font-weight:700 }.settings-tabs button.active { border-color:var(--accent); color:var(--accent); box-shadow:inset 0 -2px var(--accent) }
@media (max-width:639px) { .app-shell { padding-inline:max(1rem,env(safe-area-inset-left)) max(1rem,env(safe-area-inset-right)) }.app-header { align-items:flex-start; flex-direction:column; gap:0; padding-top:max(.8rem,env(safe-area-inset-top)) }.brand { padding-top:.25rem } nav { width:calc(100% + 2rem); margin:0 -1rem; padding-inline:1rem }.tool-grid { grid-template-columns:1fr }.dyno-data { grid-column:auto }.peaks { grid-template-columns:1fr }.card { border-radius:.85rem } }
@media (min-width:1024px) { .tool-grid { gap:1.25rem }.card { min-height:100% }.dyno-data { grid-column:span 1 }.dyno-chart { grid-column:span 1 } }
